{
  "name": "the-bananaland/bananaland-consent",
  "description": "Region-aware cookie consent and privacy choices for WordPress.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "brain/monkey": "^2.6"
  },
  "autoload-dev": {
    "psr-4": {
      "Bananaland\\Consent\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
